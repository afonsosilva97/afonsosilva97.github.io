---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="not-found">
    <p class="section-label">Page not found</p>
    <p class="msg">The page you are looking for does not exist or has been moved.</p>
    <p class="back"><a href="/">Back to the homepage</a></p>
  </section>
</Layout>

<style>
  .not-found {
    padding: 0 18px;
  }

  .msg {
    font-size: 0.98rem;
    line-height: 1.65;
    max-width: 65ch;
    margin: 0 0 22px;
  }

  .back a {
    font-family: 'Montserrat', sans-serif;
    display: inline-block;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    padding: 10px 22px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  .back a:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
