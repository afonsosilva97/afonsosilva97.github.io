---
import data from '../data/personalData';
import Layout from '../layouts/Layout.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
---

<Layout>
  <Experience
    sectionHeader="Experience"
    experienceArray={data.workExperience}
    id="experience"
    cvLink
  />
  <Skills sectionHeader="Tech Stack" skillsArray={data.techStack} id="tech" />
  <Experience sectionHeader="Internships" experienceArray={data.internships} />
  <Experience sectionHeader="Education" experienceArray={data.education} />
  <About />
</Layout>
