---
import data from '../data/personalData';
---

<footer class="section" id="contact">
  <div class="container">
    <div class="footer-container">
      <h2 class="section-title">Profiles</h2>
      <div class="social-icons">
        {
          data.social.map((socialLink) => (
            <a href={socialLink.url} target="_blank" rel="noopener noreferrer">
              <img src={socialLink.img} alt={socialLink.name} loading="lazy" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-container {
    width: 80vw;
    margin-top: 10vh;
    margin-bottom: 10vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .social-icons {
    margin-top: 15px;
  }

  .social-icons img {
    height: 2.2rem;
    margin: 10px;
  }
</style>
