---
import data from '../data/personalData';
---

<footer class="section" id="contact">
  <div class="container">
    <div class="footer-container">
      <h2 class="section-title">Contact</h2>
      <p class="contact-line">
        <a href="mailto:hello@afonsosilva.dev">hello@afonsosilva.dev</a>
      </p>
      <div class="social-icons">
        {
          data.social.map((socialLink) => (
            <a href={socialLink.url} target="_blank" rel="noopener noreferrer">
              <img src={socialLink.img} alt={socialLink.name} loading="lazy" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-container {
    width: 80vw;
    margin-top: 10vh;
    margin-bottom: 10vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-line {
    margin: 0.5em 0 0;
    font-size: 1.12em;
  }

  .contact-line a {
    color: black;
    font-weight: 600;
  }

  .social-icons {
    margin-top: 15px;
  }

  .social-icons img {
    height: 2.2rem;
    margin: 10px;
  }
</style>
