---
import data from '../data/personalData';
---

<section class="section">
  <div class="container">
    <div class="hook-container">
      <p>{data.hook}</p>
    </div>
  </div>
</section>

<style>
  .hook-container {
    width: 80vw;
    margin-top: 7.5vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  p {
    width: 50vw;
    font-size: 1.12em;
    text-align: center;
  }

  @media (max-width: 1023px) {
    p {
      width: 80vw;
    }
  }
</style>
