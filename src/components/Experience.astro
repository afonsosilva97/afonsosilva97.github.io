---
import type { Experience } from '../data/personalData';

interface Props {
  sectionHeader: string;
  experienceArray: Experience[];
  id?: string;
  cvLink?: boolean;
}

const { sectionHeader, experienceArray, id, cvLink } = Astro.props;
---

<section id={id}>
  <h2 class="section-label">{sectionHeader}</h2>
  {
    experienceArray.map((experience, index) => (
      <article class:list={['job', { hl: cvLink && index === 0 }]}>
        <p class="when">
          <span>{experience.startDate} -</span>
          <span>{experience.endDate}</span>
        </p>
        <div>
          <h3>
            <span class="logo-chip">
              <img src={experience.img} alt={`${experience.companyName} logo`} loading="lazy" />
            </span>
            {experience.title} · {experience.companyName}
          </h3>
          {experience.location && <p class="loc">{experience.location}</p>}
          {experience.descriptionParagraphs.map((paragraph) => (
            <p class="desc">{paragraph}</p>
          ))}
          {experience.tech && (
            <div class="pills">
              {experience.tech.map((t) => (
                <span class="pill">{t}</span>
              ))}
            </div>
          )}
        </div>
      </article>
    ))
  }
  {
    cvLink && (
      <p class="cv-link">
        <a href="/afonso-silva-cv.pdf">View full CV</a>
      </p>
    )
  }
</section>

<style>
  .job {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: 16px;
    padding: 17px 18px;
    border-radius: 9px;
    margin: 0;
  }

  .job.hl {
    background: var(--card);
    outline: 1px solid var(--border-strong);
  }

  .when span {
    display: block;
  }

  .when {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--text);
    padding-top: 5px;
    text-transform: uppercase;
    line-height: 1.7;
    margin: 0;
  }

  h3 {
    font-family: 'Montserrat', sans-serif;
    color: var(--heading);
    font-size: 1.12rem;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    flex-wrap: wrap;
  }

  h3 img {
    height: 18px;
    width: auto;
  }

  .loc {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 4px 0 9px;
  }

  .desc {
    font-size: 0.98rem;
    line-height: 1.62;
    max-width: 65ch;
    margin: 0 0 8px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 6px;
  }

  .pill {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    padding: 4px 11px;
  }

  .cv-link {
    padding: 26px 18px 0;
    margin: 0;
  }

  .cv-link a {
    font-family: 'Montserrat', sans-serif;
    display: inline-block;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    padding: 10px 22px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  .cv-link a:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (max-width: 880px) {
    .job {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 14px 12px;
    }

    .when span {
      display: inline;
    }

    .when span:first-child {
      margin-right: 5px;
    }

    .when {
      padding-top: 0;
    }
  }
</style>
