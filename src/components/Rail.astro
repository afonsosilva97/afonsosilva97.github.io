---
import data from '../data/personalData';
import SocialIcons from './SocialIcons.astro';
---

<aside class="rail">
  <div class="rail-inner">
    <img class="avatar" src="/images/me.jpg" alt={`Portrait of ${data.name}`} />
    <h1><a class="name-link" href="/">{data.name}</a></h1>
    <p class="role">{data.profession}</p>
    <p class="hook">{data.hook}</p>
    <nav aria-label="Sections">
      <a href="#experience">Experience</a>
      <a href="#tech">Tech Stack</a>
      <a href="#about">About</a>
    </nav>
    <div class="contact">
      <a class="mail" href={`mailto:${data.email}`}>{data.email}</a>
      <div class="social-row">
        <SocialIcons />
      </div>
    </div>
  </div>
</aside>

<style>
  .rail {
    padding: 60px 20px 60px 0;
  }

  .rail-inner {
    position: sticky;
    top: 60px;
  }

  .avatar {
    width: 150px;
    height: 150px;
    border-radius: 16px;
    object-fit: cover;
    border: 2px solid var(--border-strong);
    margin-bottom: 20px;
  }

  h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .name-link {
    color: var(--heading);
    text-decoration: none;
  }

  .role {
    font-family: 'Montserrat', sans-serif;
    color: var(--subheading);
    font-weight: 600;
    margin: 6px 0 16px;
  }

  .hook {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 36ch;
    margin: 0;
  }

  nav {
    margin: 44px 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  nav a {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  nav a::before {
    content: '';
    display: inline-block;
    width: 26px;
    height: 1px;
    background: var(--muted);
    vertical-align: middle;
    margin-right: 11px;
    transition: width 0.2s, background 0.2s;
  }

  nav a:hover {
    color: var(--heading);
  }

  nav a:hover::before {
    width: 52px;
    background: var(--accent);
  }

  .contact {
    font-size: 0.98rem;
  }

  .mail {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .social-row {
    margin-top: 14px;
  }

  @media (max-width: 880px) {
    .rail {
      padding: 40px 0 8px;
    }

    .rail-inner {
      position: static;
    }

    nav {
      margin: 28px 0;
    }
  }
</style>

<script>
  // Scroll back to the top and drop the section hash without a full reload.
  document.querySelector('.name-link')?.addEventListener('click', (event) => {
    event.preventDefault();
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    history.replaceState(null, '', window.location.pathname);
  });
</script>
