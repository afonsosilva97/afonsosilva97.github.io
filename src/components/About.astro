---
import data from '../data/personalData';
---

<section id="about">
  <p class="section-label">About</p>
  <div class="about-text">
    {data.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .about-text {
    padding: 0 18px;
    max-width: 65ch;
  }

  .about-text p {
    font-size: 0.98rem;
    line-height: 1.7;
    margin: 0 0 14px;
  }
</style>
