---
import data from '../data/personalData';
---

<section class="section" id="about">
  <div class="container">
    <div class="about-container">
      <h2 class="section-title">About Me</h2>
      <div class="about-content">
        <img class="portrait" src="/images/me.jpg" alt={`Portrait of ${data.name}`} loading="lazy" />
        <div class="about-text">
          {data.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-container {
    width: 80vw;
    margin-top: 10vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-content {
    display: flex;
    align-items: flex-start;
    gap: 40px;
    max-width: 60vw;
    margin-top: 2vh;
  }

  .portrait {
    width: 260px;
    max-width: 100%;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .about-text p {
    font-size: 1em;
    text-align: justify;
    margin-top: 0;
  }

  @media (max-width: 1023px) {
    .about-content {
      flex-direction: column;
      align-items: center;
      max-width: 80vw;
    }
  }
</style>
