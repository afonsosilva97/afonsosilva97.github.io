---
import type { Skill } from '../data/personalData';

interface Props {
  sectionHeader: string;
  skillsArray: Skill[];
  id?: string;
}

const { sectionHeader, skillsArray, id } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <div class="skills-container">
      <h2 class="section-title">{sectionHeader}</h2>
      <div class="skills-grid">
        {
          skillsArray.map((skill) => (
            <div class="skill">
              <img src={skill.img} alt={skill.name} loading="lazy" />
              <p>{skill.paragraph}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .skills-container {
    width: 80vw;
    margin-top: 8vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 4vh;
    gap: 20px;
    width: 100%;
  }

  .skill {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .skill img {
    height: 3.25rem;
  }

  .skill p {
    font-size: 1em;
  }

  @media (max-width: 767px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .skills-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
