---
import type { Skill } from '../data/personalData';

interface Props {
  sectionHeader: string;
  skillsArray: Skill[];
  id?: string;
}

const { sectionHeader, skillsArray, id } = Astro.props;
---

<section id={id}>
  <p class="section-label">{sectionHeader}</p>
  <div class="grid">
    {
      skillsArray.map((skill) => (
        <div class="tcard">
          <div class="ic">
            <span class="logo-chip">
              {skill.imgs.map((img) => (
                <img src={img} alt="" loading="lazy" />
              ))}
            </span>
          </div>
          <b>{skill.name}</b>
          <p>{skill.paragraph}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 0 18px;
  }

  .tcard {
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 15px 16px;
    background: var(--card);
  }

  .ic {
    display: flex;
    gap: 7px;
    margin-bottom: 9px;
  }

  .ic img {
    height: 24px;
    width: auto;
  }

  .tcard b {
    color: var(--heading);
    font-size: 1.02rem;
  }

  .tcard p {
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 5px 0 0;
  }

  @media (max-width: 880px) {
    .grid {
      grid-template-columns: 1fr;
      padding: 0 12px;
    }
  }
</style>
